{
  "schemaVersion": 1,
  "purpose": "Vocalizer Expressive 2.2 同音替代 renderer 的声学与音素标记对照语料",
  "rules": [
    "compareGroup 内只比较同一引擎、同一版本、同一声库、同一 operating point 和同一次运行的目标音素标记。",
    "anchor 不是语言学标注接口；最终结论必须人工听取 WAV。",
    "候选替代只存在于送往语音合成器的临时文本，绝不能改写文档、剪贴板或盲文内容。"
  ],
  "cases": [
    {
      "id": "hang2_anchor_hang",
      "text": "测试杭字",
      "targetCharIndex": 2,
      "compareGroup": "hang2_carrier",
      "role": "anchor",
      "expectedReading": "háng",
      "note": "杭是 háng 的候选锚点。"
    },
    {
      "id": "hang2_anchor_hang_navigation",
      "text": "测试航字",
      "targetCharIndex": 2,
      "compareGroup": "hang2_carrier",
      "role": "anchor",
      "expectedReading": "háng",
      "note": "航是 háng 的另一候选锚点。"
    },
    {
      "id": "hang2_source_xing",
      "text": "测试行字",
      "targetCharIndex": 2,
      "compareGroup": "hang2_carrier",
      "role": "source",
      "expectedReading": "context-free; do not auto-correct",
      "note": "孤立多音字用于观察引擎默认值，不能作为插件应改写的证据。"
    },
    {
      "id": "hang2_phrase_row_head_source",
      "text": "行首位置",
      "targetCharIndex": 0,
      "compareGroup": "hang2_row_head",
      "role": "source",
      "expectedReading": "háng"
    },
    {
      "id": "hang2_phrase_row_head_hang",
      "text": "杭首位置",
      "targetCharIndex": 0,
      "compareGroup": "hang2_row_head",
      "role": "anchor",
      "expectedReading": "háng",
      "rendererCandidate": "杭"
    },
    {
      "id": "hang2_phrase_row_head_navigation",
      "text": "航首位置",
      "targetCharIndex": 0,
      "compareGroup": "hang2_row_head",
      "role": "anchor",
      "expectedReading": "háng",
      "rendererCandidate": "航"
    },
    {
      "id": "hang2_phrase_row_number_source",
      "text": "当前是第十二行",
      "targetCharIndex": 6,
      "compareGroup": "hang2_row_number",
      "role": "source",
      "expectedReading": "háng"
    },
    {
      "id": "hang2_phrase_row_number_hang",
      "text": "当前是第十二杭",
      "targetCharIndex": 6,
      "compareGroup": "hang2_row_number",
      "role": "anchor",
      "expectedReading": "háng",
      "rendererCandidate": "杭"
    },
    {
      "id": "hang2_phrase_row_number_navigation",
      "text": "当前是第十二航",
      "targetCharIndex": 6,
      "compareGroup": "hang2_row_number",
      "role": "anchor",
      "expectedReading": "háng",
      "rendererCandidate": "航"
    },
    {
      "id": "hang2_phrase_row_column_source",
      "text": "表格共有三行四列",
      "targetCharIndex": 5,
      "compareGroup": "hang2_row_column",
      "role": "source",
      "expectedReading": "háng"
    },
    {
      "id": "hang2_phrase_row_column_hang",
      "text": "表格共有三杭四列",
      "targetCharIndex": 5,
      "compareGroup": "hang2_row_column",
      "role": "anchor",
      "expectedReading": "háng",
      "rendererCandidate": "杭"
    },
    {
