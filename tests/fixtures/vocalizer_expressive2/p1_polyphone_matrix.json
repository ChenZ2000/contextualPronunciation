{
  "schemaVersion": 1,
  "purpose": "NVDA 桌面高频 P1 多音字的 Ting-Ting 完整音素流对照矩阵",
  "voice": "Ting-Ting",
  "method": "每条原词与各读音同音锚字仅替换目标字；同一次 render 的 complete phoneme stream 完全相等时，判定原词命中该锚读音。",
  "limitations": [
    "锚字只用于探测和临时 TTS renderer 候选，绝不改写文档或盲文。",
    "experimental 锚字较生僻；未匹配时只能判为 inconclusive，不能据此认定引擎读错。",
    "音素编号是 Vocalizer 私有值，只能在同一 voice、声库版本、operating point 和同一次运行内比较。"
  ],
